{
	"firestore": {
		"rules": "firestore.rules",
		"indexes": "firestore.indexes.json"
	},
	"storage": {
		"rules": "storage.rules"
	},
	"hosting": {
		"site": "faellesbandet",
		"predeploy": [
			"node $HOME/Documents/Git/cursor-global-setup/scripts/require-published-deploy.mjs --repo faellesbandet --live https://faellesbandet.web.app/deployed.json --out build/deployed.json"
		],
		"public": "build",
		"ignore": ["firebase.json", "**/.*", "**/node_modules/**", "legacy/**", "functions/**"],
		"rewrites": [
			{
				"source": "**",
				"destination": "/index.html"
			}
		],
		"headers": [
			{
				"source": "**/*.@(js|css|svg|woff2)",
				"headers": [
					{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
				]
			},
			{
				"source": "**/*.@(html|json)",
				"headers": [
					{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
				]
			}
		]
	},
	"functions": [
		{
			"source": "functions",
			"codebase": "default",
			"runtime": "nodejs20",
			"predeploy": ["npm --prefix \"$RESOURCE_DIR\" run build"]
		}
	],
	"emulators": {
		"functions": { "port": 5001 },
		"firestore": { "port": 8080 },
		"storage": { "port": 9199 },
		"auth": { "port": 9099 },
		"hosting": { "port": 5000 },
		"ui": { "enabled": true, "port": 4000 },
		"singleProjectMode": true
	}
}
